# Storage Configuration
# Set to 'true' to persist CVs in local SQLite database (data/resumes.db).
# Set to 'false' (or leave unset) to store CVs in browser localStorage.
# Both modes support multi-CV version management, switching, duplicating, and renaming.
USE_DB=true

# Security Configuration (Optional)
# Set a master password to protect the application. If left blank or unset, no password is required.
# PASSWORD=your-strong-password-here
